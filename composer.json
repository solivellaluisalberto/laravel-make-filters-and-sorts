{
    "name": "solivellaluisalberto/laravelmakefiltersandsorts",
    "description": "Paquete Laravel para aplicar de manera eficiente filtros avanzados y ordenamientos dinámicos a consultas Eloquent a partir de parámetros de solicitudes HTTP.",
    "type": "library",
    "keywords": [
        "solivellaluisalberto",
        "php",
        "filters",
        "sorts",
        "laravel filters and sorts"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Luis Alberto Murcia Solivella",
            "email": "solivella.luisalberto@gmail.com",
            "homepage": "https://fasesdesarrollo.es"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SolivellaLuisAlberto\\LaravelMakeFiltersAndSorts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolivellaLuisAlberto\\LaravelMakeFiltersAndSorts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SolivellaLuisAlberto\\LaravelMakeFiltersAndSorts\\MakeFiltersAndSortsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
